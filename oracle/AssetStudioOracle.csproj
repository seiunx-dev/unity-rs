<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NuGetAudit>false</NuGetAudit>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
  </PropertyGroup>

  <!--
    The managed reader lives in a separate repository, Team-Haruki/AssetStudio.
    It is the compatibility oracle only; nothing shipped from this repository
    depends on it. Point AssetStudioRepo at a checkout, or leave it unset and
    keep that repository as a sibling directory of this one.
  -->
  <PropertyGroup>
    <AssetStudioRepo Condition="'$(AssetStudioRepo)' == ''">$(MSBuildThisFileDirectory)../../AssetStudio</AssetStudioRepo>
    <AssetStudioProject>$(AssetStudioRepo)/AssetStudio/AssetStudio.csproj</AssetStudioProject>
    <!-- ShaderConverter, the managed implementation the shader rows compare
         against, lives here rather than in the core reader project. -->
    <AssetStudioUtilityProject>$(AssetStudioRepo)/AssetStudioUtility/AssetStudioUtility.csproj</AssetStudioUtilityProject>
    <!-- The managed OBJ writer lives here. The mesh rows compare the exported
         document, not only the geometry it was written from. -->
    <AssetStudioCoreProject>$(AssetStudioRepo)/AssetStudioCore/AssetStudioCore.csproj</AssetStudioCoreProject>
  </PropertyGroup>

  <Target Name="RequireAssetStudioCheckout" BeforeTargets="PrepareForBuild;CollectPackageReferences">
    <Error
      Condition="!Exists('$(AssetStudioProject)') Or !Exists('$(AssetStudioUtilityProject)') Or !Exists('$(AssetStudioCoreProject)')"
      Text="The managed oracle needs a Team-Haruki/AssetStudio checkout. Looked for '$(AssetStudioProject)'. Clone it beside this repository, or pass -p:AssetStudioRepo=&lt;path&gt;." />
  </Target>

  <ItemGroup>
    <ProjectReference
      Include="$(AssetStudioProject)"
      SetTargetFramework="TargetFramework=net10.0" />
    <ProjectReference
      Include="$(AssetStudioUtilityProject)"
      SetTargetFramework="TargetFramework=net10.0" />
    <ProjectReference
      Include="$(AssetStudioCoreProject)"
      SetTargetFramework="TargetFramework=net10.0" />
  </ItemGroup>

</Project>
